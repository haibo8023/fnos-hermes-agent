#!/bin/bash

### 安装前回调 — 清理残留进程和 socket，避免安装时权限设置失败

TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/hermes-agent}"
TRIM_PKGHOME="${TRIM_PKGHOME:-/var/apps/hermes-agent/home}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/vol1/@appdata/hermes-agent}"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [install_init] $1"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "=== install_init start ==="
log_msg "TRIM_APPDEST=${TRIM_APPDEST}"
log_msg "TRIM_PKGVAR=${TRIM_PKGVAR}"
log_msg "TRIM_USERNAME=${TRIM_USERNAME:-<empty>}"

# 记录安装前目录状态
log_msg "--- 目录状态 (安装前) ---"
ls -la "${TRIM_APPDEST}" 2>&1 | while IFS= read -r line; do log_msg "  $line"; done

# 强制 kill 可能残留的进程（node 为实际运行时，bun 为历史兼容）
pkill -9 -f "node.*monitor\.js" 2>/dev/null || true
pkill -9 -f "bun.*monitor\.js" 2>/dev/null || true
pkill -9 -f "hermes.*gateway" 2>/dev/null || true
pkill -9 -f "hermes.*dashboard" 2>/dev/null || true

# ⚠️ 常驻辅助进程（bill-watcher / photo_describer / chat-record-archiver）不在 monitor.js
# 进程树里，pkill 漏掉后它们会一直写 data/，导致 fnOS 回滚 rm -rf 报 "directory not empty"
# → 回滚失败 → 数据丢失（2026-09-28 事故）。
for _pat in "bill-watcher" "bill_watcher" "photo_describer" "photo-describer" \
            "chat-record-archiver" "chat_record_archiver" "gateway_watchdog" \
            "${TRIM_PKGHOME}/data/scripts/"; do
    pkill -9 -f "${_pat}" 2>/dev/null || true
done
log_msg "辅助进程清理完成 (bill-watcher / photo_describer / chat-record-archiver)"

# 等待进程完全退出（最多 15 秒），避免文件句柄残留导致 fnOS 权限设置失败
_wait=0
while [ ${_wait} -lt 15 ]; do
    if ! pgrep -f "node.*monitor\.js" >/dev/null 2>&1 \
       && ! pgrep -f "bun.*monitor\.js" >/dev/null 2>&1 \
       && ! pgrep -f "hermes.*gateway" >/dev/null 2>&1 \
       && ! pgrep -f "hermes.*dashboard" >/dev/null 2>&1 \
       && ! pgrep -f "bill-watcher|bill_watcher|photo_describer|chat-record-archiver" >/dev/null 2>&1; then
        break
    fi
    sleep 1
    _wait=$((_wait + 1))
done
log_msg "进程清理完成 (等待 ${_wait}s)"

# 删除残留 socket
rm -f "${TRIM_APPDEST}/hermes-agent.sock" 2>/dev/null || true
rm -f "/var/apps/hermes-agent/target/hermes-agent.sock" 2>/dev/null || true
log_msg "socket 清理完成"

# 清理可重建的缓存（同 upgrade_init）
TRIM_PKGHOME="${TRIM_PKGHOME:-/vol1/@apphome/hermes-agent}"
CACHE_DIR="${TRIM_PKGHOME}/data/.cache"
if [ -d "${CACHE_DIR}" ]; then
    CACHE_SIZE="$(du -sh "${CACHE_DIR}" 2>/dev/null | awk '{print $1}')"
    log_msg "清理 .cache 目录 (${CACHE_SIZE})"
    rm -rf "${CACHE_DIR}/ms-playwright" "${CACHE_DIR}/chrome-devtools-mcp" "${CACHE_DIR}/node" "${CACHE_DIR}/uv" 2>/dev/null || true
fi
# ⚠️ 严禁删除 fnOS 的回滚备份目录：升级失败时它是唯一的数据来源（2026-09-28 数据全丢事故）
log_msg "跳过回滚备份目录清理（交给 fnOS 自管）"

# ── 升级前自救备份（覆盖式安装时同样需要；@appdata 不参与 apphome 回滚）──
BK_ROOT="${TRIM_PKGVAR:-/vol1/@appdata/hermes-agent}/preupgrade-backup"
if [ -d "${TRIM_PKGHOME}/data" ]; then
    mkdir -p "${BK_ROOT}" 2>/dev/null || true
    BK_FILE="${BK_ROOT}/data-$(date +%Y%m%d-%H%M%S).tar.gz"
    if tar czf "${BK_FILE}.part" -C "${TRIM_PKGHOME}/data" \
         --exclude='./venv' --exclude='./.cache' --exclude='./node' \
         --exclude='./npm-global' --exclude='./uv' --exclude='./.uv-cache' \
         --exclude='./workspace/recovery-backups' \
         --exclude='*.log' --exclude='*.log.*' . 2>/dev/null; then
        mv -f "${BK_FILE}.part" "${BK_FILE}" 2>/dev/null || rm -f "${BK_FILE}.part"
        log_msg "自救备份完成: ${BK_FILE} ($(du -h "${BK_FILE}" 2>/dev/null | cut -f1))"
    else
        rm -f "${BK_FILE}.part" 2>/dev/null || true
        log_msg "WARNING: 自救备份失败（继续安装）"
    fi
    ls -1t "${BK_ROOT}"/data-*.tar.gz 2>/dev/null | tail -n +4 | while IFS= read -r _old; do rm -f "${_old}" 2>/dev/null || true; done
fi

# 端口冲突清理：安装前杀掉占用应用端口（8650 UI / 8742 gateway / 9219 dashboard）的旧 hermes 进程，
# 避免端口被占导致安装或启动失败（例如残留的独立安装 gateway）
for PORT in 8650 8742 9219; do
    PID=$(ss -tlnp 2>/dev/null | grep ":${PORT} " | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)
    if [ -n "$PID" ]; then
        # 只清理 hermes 相关进程（防止误杀其它应用）
        CMDLINE=$(ps -p "$PID" -o cmd= 2>/dev/null | grep -iE 'hermes|monitor|gateway' || true)
        if [ -n "$CMDLINE" ]; then
            log_msg "端口 ${PORT} 被 hermes 进程 pid=${PID} 占用，清理旧进程"
            kill -9 "$PID" 2>/dev/null || true
        fi
    fi
done
sleep 1
log_msg "端口冲突清理完成"

# 清理残留的版本覆盖文件（@appdata 不随卸载清除，旧 override 会导致 UI 显示旧版本号）
rm -f "${TRIM_PKGVAR}/app_version" 2>/dev/null || true
log_msg "app_version 覆盖文件清理完成"

# 全新安装检测：hermes 从未配置过（无 config.yaml）时，@appdata 残留的配置类文件
# （上一环境的 extensions.json / providers-state 等）会导致新装后左侧会话树
# 出现一堆旧角色分组、模型页出现不可用的假 provider。
# 仅清理配置类文件，保留 chat/ 会话历史与日志；升级安装（有 config.yaml）不动。
# 注意：appcenter-cli install-fpk 可能不传 TRIM_PKGHOME env → 探测实际路径，防误判全新安装清空配置
_HAS_CFG=0
for _cand in "${TRIM_PKGHOME}/data/config.yaml" \
             "/var/apps/hermes-agent/home/data/config.yaml" \
             "/vol1/@apphome/hermes-agent/data/config.yaml" \
             "/vol3/@apphome/hermes-agent/data/config.yaml"; do
  if [ -f "$_cand" ]; then _HAS_CFG=1; break; fi
done
if [ "$_HAS_CFG" = "0" ]; then
    rm -f "${TRIM_PKGVAR}/extensions.json" \
          "${TRIM_PKGVAR}/providers-state.yaml" \
          "${TRIM_PKGVAR}/provider-models.json" \
          "${TRIM_PKGVAR}/.env.providers" 2>/dev/null || true
    log_msg "全新安装（未探测到 hermes 配置）：残留配置类文件清理完成"
else
    log_msg "检测到已有 hermes 配置（升级安装），保留 @appdata 配置"
fi

# 额外等待 2 秒，确保文件系统释放所有句柄
sleep 2

# 记录清理后目录状态
log_msg "--- 目录状态 (清理后) ---"
ls -la "${TRIM_APPDEST}" 2>&1 | while IFS= read -r line; do log_msg "  $line"; done

log_msg "=== install_init end ==="
exit 0

